# Copy to .env and change what you need. The server reads this file when it starts.
# On Vercel, set the same names under Settings → Environment Variables instead.

# Sign-in for you, the platform owner (sees every company). Set this before going live.
PLATFORM_ADMIN_EMAIL=admin@starbangla.local
PLATFORM_ADMIN_PASSWORD=change-this-password

# Demo company with one login per role. Keep 0 on a public server unless you want visitors to try it.
DEMO_ACCOUNTS=1
DEMO_PASSWORD=demo1234

# Where the books are kept.
# Leave DATABASE_URL empty to use files in server/data (your own computer or server).
# On Vercel, adding Neon from the Storage tab sets DATABASE_URL for you.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# PORT=8787
# DATA_DIR=./server/data

# Courier booking (Courier → Couriers). Keys here stay on the server and win over keys saved in the app.
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=
# PATHAO_PASSWORD=
# PATHAO_STORE_ID=
# PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com   (sandbox while testing)
# REDX_TOKEN=
# REDX_BASE_URL=https://sandbox.redx.com.bd/v1.0.0-beta    (sandbox while testing)

# WhatsApp Business (Cloud API) and SMS (Messages → Settings). Kept on the server, never sent to a browser.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=            (approved template with one body variable)
# WHATSAPP_TEMPLATE_LANGUAGE=en
# SMS_API_KEY=                  (BulkSMSBD by default)
# SMS_SENDER_ID=
# SMS_GATEWAY=                  (empty for BulkSMSBD, or https://...{to}...{message}...{apiKey}...{sender})

# Subscriptions (Settings → Subscription). New companies get a free trial; when it ends the books are read-only until a plan is paid.
# TRIAL_DAYS=14
# APP_URL=https://your-app.example.com           (public address, needed for online payment)
# SSLCommerz takes bKash, Nagad, Rocket and cards in one checkout. Sandbox until SSLCOMMERZ_SANDBOX=0.
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=
# SSLCOMMERZ_SANDBOX=1
# BILLING_TEST_PAYMENTS=1                        (no gateway: simulate online payments, nothing is charged)
# Shown to customers who pay by hand and press "I paid"; you approve them in the platform owner screen.
# BILLING_BKASH_NUMBER=01XXXXXXXXX (Merchant)
# BILLING_NAGAD_NUMBER=
# BILLING_BANK_DETAILS=Bank name, account name, account number, branch

# AI assistant (the chat button). Claude reads the company's books through read-only look-ups limited to each person's role.
# Without a key, questions are answered by the built-in answerer (no AI, common questions only).
# ANTHROPIC_API_KEY=
