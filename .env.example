# Copy to .env and change what you need. The server reads this file when it starts.
# On Vercel, set the same names under Settings → Environment Variables instead.

# Sign-in for you, the platform owner (sees every company). Set this before going live.
PLATFORM_ADMIN_EMAIL=admin@starbangla.local
PLATFORM_ADMIN_PASSWORD=change-this-password

# Demo company with one login per role. Keep 0 on a public server unless you want visitors to try it.
DEMO_ACCOUNTS=1
DEMO_PASSWORD=demo1234

# Where the books are kept.
# Leave DATABASE_URL empty to use files in server/data (your own computer or server).
# On Vercel, adding Neon from the Storage tab sets DATABASE_URL for you.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# PORT=8787
# DATA_DIR=./server/data

# Courier booking (Courier → Couriers). Keys here stay on the server and win over keys saved in the app.
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# PATHAO_CLIENT_ID=
# PATHAO_CLIENT_SECRET=
# PATHAO_USERNAME=
# PATHAO_PASSWORD=
# PATHAO_STORE_ID=
# PATHAO_BASE_URL=https://courier-api-sandbox.pathao.com   (sandbox while testing)
# REDX_TOKEN=
# REDX_BASE_URL=https://sandbox.redx.com.bd/v1.0.0-beta    (sandbox while testing)
